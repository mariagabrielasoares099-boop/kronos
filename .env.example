# Copie para .env (NUNCA commitar). Em produção use um cofre (AWS Secrets Manager, Doppler ou Vault).
# A API conecta com o papel kronos_api (sem BYPASSRLS): apps/api/prisma/dev/app-role.sql. Superusuario faz a API recusar o boot.
DATABASE_URL=postgresql://kronos_api:kronos_api_dev@localhost:5432/kronos
# Usada so por `prisma migrate` (dono/administrador do banco).
MIGRATE_DATABASE_URL=postgresql://kronos:kronos_dev@localhost:5432/kronos
REDIS_URL=redis://localhost:6379
# Pasta dos documentos enviados (disco local, relativa a apps/api). Nunca servir por URL publica.
STORAGE_DIR=./storage
JWT_SECRET=troque-me
ENCRYPTION_KEY=chave-de-32-bytes-para-credenciais-de-erp
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
EMAIL_API_KEY=
# Link de acesso do candidato (e-mail). Dev: Mailpit do docker-compose (caixa em http://localhost:8025). Producao: SMTP_URL obrigatoria.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=KRONOS <nao-responda@kronos.local>
PORTAL_BASE_URL=http://localhost:8000
WHATSAPP_TOKEN=
SIGNATURE_PROVIDER_TOKEN=
AI_PROVIDER_API_KEY=
# IA local e gratuita (Ollama, https://ollama.com). Sem chave: `ollama pull llama3.2` e `ollama serve`.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Embeddings do RAG: `ollama pull nomic-embed-text`. Sem ele a busca cai para palavras-chave (continua funcionando).
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_S=60
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Pasta dos documentos enviados (disco local; padrao ./storage a partir de apps/api)
STORAGE_DIR=./storage

# Login de teste para exposicao (so com DEMO_MODE=true e dados ficticios). Desligado por padrao.
# EXPO_LOGIN=true
# EXPO_EMAIL=equipe.teste@exemplo.test
# EXPO_SENHA=troque-antes-de-expor
# MCP por HTTP (POST /mcp, so no modo demo): token Bearer opcional para clientes remotos (24+ caracteres)
# MCP_TOKEN=
