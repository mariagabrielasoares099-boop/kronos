name: CI
on:
  push:
    branches: [main]
  pull_request:
jobs:
  secrets-scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
  # Adicionar jobs de lint/test/build quando houver código (passo 6 e 10).
